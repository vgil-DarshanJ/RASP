# Copy to .env.local for the office LAN setup (server 192.168.2.208).
# Read by `next build`: change it, then build again.

# Backend API base.
NEXT_PUBLIC_API_BASE_URL="http://192.168.2.208:4444"

# The two sites this one build serves (lib/sites.ts):
#   npm run start:portal  -> customer portal on port 5050
#   npm run start:visitor -> visitor site on port 6050
# A page opened on the wrong one is sent to the other. Leave both empty to
# serve every page from one origin (e.g. `npm run dev` on a laptop).
NEXT_PUBLIC_PORTAL_URL="http://192.168.2.208:5050"
NEXT_PUBLIC_VISITOR_URL="http://192.168.2.208:6050"
