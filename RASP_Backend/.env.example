# Local dev only — copy to .env and fill in. Never commit the real .env.

# Postgres (matches docker-compose.yml's local Postgres container)
DATABASE_URL="postgresql://rasp:rasp_dev_password@localhost:5432/rasp_shield?schema=public"

# Redis (matches docker-compose.yml's local Redis container)
REDIS_URL="redis://localhost:6379"

# JWT signing secret — generate a real random 32+ byte value for anything
# beyond local dev (e.g. `openssl rand -base64 48`).
JWT_SECRET="dev-only-change-me-before-any-real-deployment"
JWT_EXPIRES_IN="7d"

# Master key for encrypting ApiCredential.apiSecretEncrypted at rest (see
# src/crypto/secretBox.ts) — MUST be exactly 32 bytes, hex-encoded (64 hex
# characters). Generate one with:
#   openssl rand -hex 32
# Treat this exactly like a database root password: losing/rotating it
# invalidates every already-issued credential's HMAC verification, and it
# must never be committed to source control. This example value is a
# placeholder only — the server refuses to start if it isn't replaced with
# a real 64-hex-char value.
CREDENTIAL_ENCRYPTION_KEY="REPLACE_WITH_OUTPUT_OF__openssl_rand_-hex_32"

# What this backend tells the frontend / issued JSON credentials its own
# ingestion endpoint is reachable at.
PUBLIC_INGESTION_URL="http://localhost:4000/v1/events"

# Ingestion HMAC request-signing — see src/crypto/hmac.ts and
# src/middleware/apiKey.ts. A request whose X-Timestamp drifts from the
# server's clock by more than this is rejected outright (replay-window
# bound); a request whose exact signature was already seen within this
# same window is rejected as a replay regardless of timestamp freshness.
INGESTION_SIGNATURE_TOLERANCE_SECONDS=300

# Ingestion rate limit — requests (batches, not individual events) per app +
# device per window (envelope deviceKeyId, or the legacy batch's deviceId).
# Each device of an app has its own budget; tune down if you see abuse.
INGESTION_RATE_LIMIT_PER_WINDOW=60
INGESTION_RATE_LIMIT_WINDOW_SECONDS=60
# POST /v1/devices/register limit per app + device key, separate bucket from ingestion.
DEVICE_REGISTRATION_RATE_LIMIT_PER_WINDOW=60
DEVICE_REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=60
# Coarse ceilings on top of the per-device limits (same window): per API key
# (the whole app) and per client IP. Mobile carriers put many phones behind
# one IP (CGNAT), so keep the per-IP values generous.
INGESTION_RATE_LIMIT_PER_API_KEY=6000
INGESTION_RATE_LIMIT_PER_IP=1200
DEVICE_REGISTRATION_RATE_LIMIT_PER_API_KEY=600
DEVICE_REGISTRATION_RATE_LIMIT_PER_IP=120
# Set when running behind a load balancer/proxy (e.g. 1 = one proxy hop),
# otherwise every request has the proxy IP. Leave empty for direct traffic.
TRUST_PROXY=

PORT=4000
NODE_ENV=development

# Local-dev-only SDK distribution — see src/sdk-distribution/routes.ts.
# Points at your sdk_rasp checkout so /v1/sdk/download/:platform can zip
# the real source. A real deployment replaces this whole mechanism with a
# published package registry.
SDK_SOURCE_ROOT="C:/Users/user/Downloads/vedant/sdk_rasp"

# Comma-separated list of origins the FE dev server runs on.
CORS_ORIGINS="http://localhost:3000"

# GET /v1/ip-risk — country and risk flags for the caller's IP, used by the
# SDK's high_risk_ip detector (the SDK no longer calls a geo service itself).
# The client IP is req.ip, so set TRUST_PROXY correctly when behind a proxy.
# Countries (ISO 3166-1 alpha-2, comma-separated, any case) that set
# flags.blocked_country. Empty = this default.
IP_RISK_BLOCKED_COUNTRIES="KP,IR,SY"
# Where the country comes from:
#   lookup — server-side HTTP lookup at IP_RISK_LOOKUP_URL (results cached per IP)
#   header — a country header set by your CDN/proxy (IP_RISK_COUNTRY_HEADER);
#            used only when the request came through a proxy trusted via TRUST_PROXY
#   none   — no source: country stays null and the SDK reports "cannot decide"
IP_RISK_GEO_SOURCE="none"
# URL template for IP_RISK_GEO_SOURCE=lookup; {ip} is replaced by the client IP
# (3 s timeout). The provider sees your users' IPs — use one you have an
# agreement with. Example: https://ipapi.co/{ip}/json/
IP_RISK_LOOKUP_URL=
# Country header for IP_RISK_GEO_SOURCE=header (Cloudflare: cf-ipcountry).
IP_RISK_COUNTRY_HEADER="cf-ipcountry"
# Seconds a looked-up result is cached per IP (0 = no cache). Only the geo data
# is cached, so a changed IP_RISK_BLOCKED_COUNTRIES applies immediately.
IP_RISK_CACHE_SECONDS=3600
# Rate limits for /v1/ip-risk in the same window: per client IP, per API key.
IP_RISK_RATE_LIMIT_PER_IP=60
IP_RISK_RATE_LIMIT_PER_API_KEY=6000
IP_RISK_RATE_LIMIT_WINDOW_SECONDS=60
# Development only — ignored when NODE_ENV=production. A phone on your LAN
# reaches the backend from a private address, which cannot be placed in a
# country; set a two-letter code here to treat private addresses as that
# country (response source "dev_override").
IP_RISK_DEV_PRIVATE_IP_COUNTRY=
