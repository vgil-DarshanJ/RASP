{
  "name": "rasp-shield-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "seed:map-points": "tsx scripts/seed-map-points.ts",
    "seed:risk-events": "tsx scripts/seed-risk-events.ts",
    "reputation:keygen": "tsx scripts/reputation-keygen.ts",
    "export:severities": "tsx scripts/export-severities.ts",
    "test:db": "tsx --test test/db.integration.test.ts",
    "retention:run": "tsx scripts/retention-run.ts",
    "check:config": "tsx scripts/check-config.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.7",
    "nodemailer": "^10.0.16",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true
  }
}
