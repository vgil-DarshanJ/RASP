# Copy to deploy/production.env (git-ignored) and fill in. Never commit the
# filled-in file. Generate secrets on the server, for example:
#   openssl rand -hex 32        (CREDENTIAL_ENCRYPTION_KEY: exactly 64 hex characters)
#   openssl rand -base64 48     (JWT_SECRET, POSTGRES_PASSWORD)

# Public host name with DNS pointing at this server (no https://, no path).
DOMAIN=rasp.example.com
# Let's Encrypt account e-mail for the certificate.
ACME_EMAIL=admin@example.com

POSTGRES_PASSWORD=replace-me
JWT_SECRET=replace-me
JWT_EXPIRES_IN=8h
CREDENTIAL_ENCRYPTION_KEY=replace-me-with-64-hex-characters

# Optional: signed malware reputation list (deploy/reputation/list.json,
# key from `npm run reputation:keygen`).
REPUTATION_SIGNING_KEY=

# Signed remote configuration (`npm run config:keygen`; secret).
CONFIG_SIGNING_KEY=

# Retention in days (0 = keep); set from the DPIA.
RETENTION_SECURITY_EVENT_DAYS=180
RETENTION_RISK_EVENT_DAYS=180
RETENTION_DEVICE_LOCATION_DAYS=30

# Forgot-password e-mails (required in production; without SMTP no reset
# link is sent). Any SMTP provider; port 587 STARTTLS or 465 (SMTP_SECURE=1).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
MAIL_FROM=RASP Shield <no-reply@example.com>

# IP risk (see .env.example): lookup | header | none
IP_RISK_GEO_SOURCE=none

BACKUP_KEEP_DAYS=14

# Google Play Integrity, server-side verification (src/integrity/,
# docs/PLAY_INTEGRITY_SETUP.md). Service account JSON key file (outside git,
# readable only by the backend user) and the package names accepted. Either
# empty = /v1/integrity/* answer 503 PLAY_INTEGRITY_NOT_CONFIGURED.
# PLAY_INTEGRITY_REQUIRE: PLAY_RECOGNIZED (installed from Play; default),
# LICENSED, STRONG — comma-separated; empty = device integrity only (for
# sideloaded test builds).
PLAY_INTEGRITY_SERVICE_ACCOUNT_FILE=/secrets/play-integrity.json
PLAY_INTEGRITY_ALLOWED_PACKAGES=
PLAY_INTEGRITY_REQUIRE=PLAY_RECOGNIZED
PLAY_INTEGRITY_MAX_TOKEN_AGE_SECONDS=300
